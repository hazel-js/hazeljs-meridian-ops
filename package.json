{
  "name": "hazeljs-meridian-ops",
  "version": "1.0.0",
  "description": "Meridian Ops Platform — HazelJS Agent OS flagship (DNA, Store, Skillgate, HITL, multi-agent, local control plane)",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/main.js",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "test": "jest --runInBand",
    "store:sync": "ts-node --transpile-only scripts/store-sync.ts",
    "store:sync:remote": "ts-node --transpile-only scripts/store-sync.ts -- --remote",
    "platform:sync": "ts-node --transpile-only scripts/platform-sync.ts",
    "platform:k8s-dryrun": "ts-node --transpile-only scripts/platform-k8s-dryrun.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "tour": "ts-node --transpile-only scripts/tour.ts",
    "demo:smoke-cli": "ts-node --transpile-only scripts/demo-smoke-cli.ts",
    "demo:scenarios": "ts-node --transpile-only scripts/demo-scenarios.ts",
    "mcp": "ts-node --transpile-only src/mcp/main.ts",
    "report": "ts-node --transpile-only scripts/skillgate-report.ts",
    "gatekeeper:validate": "ts-node --transpile-only scripts/gatekeeper-validate.ts",
    "example:rag": "npm --prefix examples run rag",
    "example:cag": "npm --prefix examples run cag",
    "example:kag": "npm --prefix examples run kag",
    "example:context": "npm --prefix examples run context",
    "example:decision-plane": "npm --prefix examples run decision-plane",
    "example:governed-runtime": "npm --prefix examples run governed-runtime",
    "example:governed-memory": "npm --prefix examples run governed-memory",
    "example:ai-call-contract": "npm --prefix examples run ai-call-contract",
    "example:install": "npm --prefix examples install",
    "postinstall": "prisma generate || true"
  },
  "dependencies": {
    "@hazeljs/agent": "file:../hazeljs/packages/agent",
    "@hazeljs/agent-gatekeeper": "file:../hazeljs/packages/agent-gatekeeper",
    "@hazeljs/agent-vm": "file:../hazeljs/packages/agent-vm",
    "@hazeljs/ai": "file:../hazeljs/packages/ai",
    "@hazeljs/core": "file:../hazeljs/packages/core",
    "@hazeljs/decision": "file:../hazeljs/packages/decision",
    "@hazeljs/eval": "file:../hazeljs/packages/eval",
    "@hazeljs/flow": "file:../hazeljs/packages/flow",
    "@hazeljs/inspector": "file:../hazeljs/packages/inspector",
    "@hazeljs/mcp": "file:../hazeljs/packages/mcp",
    "@hazeljs/memory": "file:../hazeljs/packages/memory",
    "@hazeljs/prompts": "file:../hazeljs/packages/prompts",
    "@hazeljs/skillgate": "file:../hazeljs/packages/skillgate",
    "@hazeljs/swagger": "file:../hazeljs/packages/swagger",
    "@hazeljs/testing": "file:../hazeljs/packages/testing",
    "@prisma/client": "^6.19.3",
    "openai": "^6.42.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "openai": "^6.42.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "author": "HazelJS",
  "license": "Apache-2.0"
}
