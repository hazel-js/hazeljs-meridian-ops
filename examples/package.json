{
  "name": "meridian-context-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Offline CAG / KAG / Context / Decision Plane / governed / AI call-contract / AAR labs for Meridian Ops",
  "scripts": {
    "rag": "ts-node --project tsconfig.json --transpile-only rag-helpdesk-agent/index.ts",
    "cag": "ts-node --project tsconfig.json --transpile-only cag-support-agent/index.ts",
    "kag": "ts-node --project tsconfig.json --transpile-only kag-commerce-agent/index.ts",
    "context": "ts-node --project tsconfig.json --transpile-only context-auto-agent/index.ts",
    "decision-plane": "ts-node --project tsconfig.json --transpile-only decision-plane-agent/index.ts",
    "governed-runtime": "ts-node --project tsconfig.json --transpile-only governed-runtime-agent/index.ts",
    "governed-memory": "ts-node --project tsconfig.json --transpile-only governed-memory-agent/index.ts",
    "ai-call-contract": "ts-node --project tsconfig.json --transpile-only -r reflect-metadata ai-call-contract-agent/index.ts",
    "autonomous": "ts-node --project tsconfig.json --transpile-only -r reflect-metadata autonomous-order-ops/index.ts"
  },
  "dependencies": {
    "@hazeljs/agent-gatekeeper": "file:../../hazeljs/packages/agent-gatekeeper",
    "@hazeljs/ai": "file:../../hazeljs/packages/ai",
    "@hazeljs/autonomous": "file:../../hazeljs/packages/autonomous",
    "@hazeljs/core": "file:../../hazeljs/packages/core",
    "@hazeljs/cag": "2.0.14",
    "@hazeljs/context": "2.0.14",
    "@hazeljs/decision": "file:../../hazeljs/packages/decision",
    "@hazeljs/eval": "file:../../hazeljs/packages/eval",
    "@hazeljs/kag": "2.0.14",
    "@hazeljs/memory": "file:../../hazeljs/packages/memory",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
