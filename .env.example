# Server
PORT=3060
API_BASE_URL=http://127.0.0.1:3060
API_TOKEN=meridian-dev-token

# LLM — leave empty for DemoLLM (no API key).
OPENAI_API_KEY=
AGENT_MODEL=gpt-4o-mini

# Agent OS
AGENT_OS_TIMELINE_FILE=./.hazel/timeline.jsonl
AGENT_OS_SUCCESS_SCORE=80
AGENT_OS_MAX_LOOP=4
# Set to 1 to pause on refund / freeze approvals (HITL).
AGENT_OS_HITL=0

# Agent Gatekeeper — authorize every tool call (default on). Set 0 to use PolicyEngine only.
AGENT_OS_GATEKEEPER=1
# AGENT_OS_GATEKEEPER_MODE=enforce
# MERIDIAN_TENANT_ID=meridian
# GATEKEEPER_ENVIRONMENT=development
# Shared approvals across replicas (optional; default is durable HumanTaskService):
# GATEKEEPER_REDIS_URL=redis://127.0.0.1:6379

# Agent VM — effect types, journaling, speculation (default off)
# AGENT_OS_AGENT_VM=1
# AGENT_OS_AGENT_VM_BARRIER=converge
# AGENT_OS_AGENT_VM_STORE_BUFFER=0

# Durable runs: file (default) | sql (Prisma SQLite — see Phase 6)
AGENT_OS_DURABLE_BACKEND=file
AGENT_OS_DURABLE_DIR=./.hazel/runs
# Required when AGENT_OS_DURABLE_BACKEND=sql:
# DATABASE_URL=file:./.hazel/meridian.db

# Optional FlowEngine peer for durable HITL mirror (ADR-003 refund saga bridge)
AGENT_OS_FLOW_PEER=0

# DNA overlay from platform store / marketplace (prompt + policies only).
AGENT_OS_DNA_OVERLAY=1

# Skillgate
SKILLGATE_HITL=0
SKILLGATE_ALLOW_ADMIN=0
SKILLGATE_ALLOW_DESTRUCTIVE=0

# Local registry root (default: ./.hazel/registry)
# HAZEL_REGISTRY_ROOT=./.hazel/registry

# Optional Cloud Team SKU (Journey D / F22) — not required for local tour
# Point at hazeljs-cloud-backend (AGENT_REGISTRY_BACKEND=file is enough) or hosted Team URL.
# HAZEL_REGISTRY_URL=http://127.0.0.1:3000
# HAZEL_REGISTRY_TOKEN=
